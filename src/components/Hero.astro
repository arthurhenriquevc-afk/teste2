---
import { home } from '../data/home';
import { anchor } from '../config/urls';
import SurveyScene from './SurveyScene.astro';
import Icon from './Icon.astro';
---
<section id="destaques" class="hero dark" aria-label="Destaques">
 <div class="container">
 <div class="hero-stage"><div class="hero-stories">
 {home.hero.map((slide,i)=><article class="hero-slide" aria-label={`${i+1} de 3`} data-slide hidden={i!==0}>
  <div class="hero-copy">{i===0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}<p>{slide.text}</p>
   <div class="actions">{slide.buttons.map((label,b)=><a class:list={['button',b===0 ? 'light':'outline']} href={label.startsWith('Serviços') ? `${import.meta.env.BASE_URL}?publico=${label==='Serviços para empresas'?'empresas':'profissionais'}#janelas` : anchor(label.includes('janelas') ? 'janelas' : 'contato')} data-filter-target={label==='Serviços para empresas' ? 'Empresas' : label==='Serviços para profissionais' ? 'Profissionais' : undefined}>{label}{b===0 && <Icon/>}</a>)}</div>
  </div>
 </article>)}
 </div><div class="hero-visual"><SurveyScene/></div></div>
 <div class="hero-controls js-only"><div class="hero-indicators">{home.hero.map((_,i)=><button type="button" aria-label={`Ir para o slide ${i+1}`} aria-current={i===0 ? 'true':undefined} data-go-slide={i}>{String(i+1).padStart(2,'0')}</button>)}</div><div class="actions"><button class="icon-button" data-hero-prev aria-label="Slide anterior"><Icon name="left"/></button><button class="icon-button" data-hero-next aria-label="Próximo slide"><Icon/></button></div><span class="sr-only" aria-live="polite" data-hero-status></span></div>
 </div>
</section>
<noscript><style is:inline>.hero-slide[hidden]{display:block!important}</style></noscript>
<script>
 import { motion } from '../scripts/motion-utils';
 const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
 const indicators = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-go-slide]'));
 let active = 0;
 const show = (index: number, announce = true) => {
  const previous = active;
  active = (index+slides.length)%slides.length;
  slides.forEach((s,i)=>{s.hidden=i!==active;});
  indicators.forEach((b,i)=>{if(i===active)b.setAttribute('aria-current','true');else b.removeAttribute('aria-current');});
  if(announce) document.querySelector('[data-hero-status]')!.textContent=`Slide ${active+1} de ${slides.length}`;
  const current = slides[active];
  const direction = active >= previous ? 1 : -1;
  motion(current.querySelector('h1,h2'), [
   { clipPath: `inset(0 ${direction > 0 ? '100%' : '0'} 0 ${direction < 0 ? '100%' : '0'})`, transform: `translateX(${direction * 24}px)`, opacity: .45 },
   { clipPath: 'inset(0 0 0 0)', transform: 'translateX(0)', opacity: 1 },
  ], { duration: announce ? 640 : 780 });
  motion(current.querySelector('p'), [{ opacity: .3, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 480, delay: 100, fill: 'backwards' });
  motion(current.querySelector('.actions'), [{ opacity: .4, transform: 'translateY(8px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 400, delay: 180, fill: 'backwards' });
  if (announce) document.dispatchEvent(new CustomEvent('hero:change', { detail: { index: active } }));
 };
 show(0,false);
 indicators.forEach((b,i)=>b.addEventListener('click',()=>show(i)));
 document.querySelector('[data-hero-prev]')?.addEventListener('click',()=>show(active-1));
 document.querySelector('[data-hero-next]')?.addEventListener('click',()=>show(active+1));
</script>
<style>
 .hero{overflow:clip}
 .hero-stage{display:grid;grid-template-columns:1.35fr 1fr;gap:var(--space-7);min-height:690px;align-items:center}
 .hero-stories{min-width:0}
 .hero-slide{display:block;padding-block:var(--space-8)}
 .hero-copy{padding-block:var(--space-6)}
 .hero-copy h2{font-size:var(--text-display)}
 .hero-copy p{margin-top:var(--space-6);margin-bottom:var(--space-7);font-size:var(--text-md);max-width:45ch}
 .hero-visual{height:100%;min-width:0;padding-block:var(--space-6)}
 .hero-controls{position:relative;display:flex!important;align-items:center;justify-content:space-between;gap:var(--space-5);border-top:1px solid var(--color-line-dark);padding-block:var(--space-5)}
 html:not([data-enhanced]) .hero-controls{display:none!important}
 .hero-indicators{display:flex;gap:var(--space-3)}
 .hero-indicators button{position:relative;min-width:52px;color:inherit;font-size:var(--text-sm);font-variant-numeric:tabular-nums;opacity:.6;transition:opacity var(--duration-fast) var(--ease-out)}
 .hero-indicators button[aria-current]{opacity:1}
 .hero-indicators button:after{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform var(--duration-normal) var(--ease-out)}
 .hero-indicators button[aria-current]:after{transform:scaleX(1)}
 @media(max-width:960px){
  .hero-stage{grid-template-columns:1.25fr 1fr;gap:var(--space-5);min-height:600px}
  .hero-slide{padding-block:var(--space-7)}
  .hero-copy{padding-block:0}
  .hero-copy .actions{gap:var(--space-3)}
  .hero-copy h1,.hero-copy h2{font-size:clamp(2.2rem,4.5vw,3.6rem)}
 }
 @media(max-width:600px){
  .hero-stage{grid-template-columns:1fr;gap:0;min-height:0}
  .hero-slide{padding-top:var(--space-7);padding-bottom:0}
  .hero-copy h1,.hero-copy h2{font-size:clamp(2rem,7.7vw,3rem)}
  .hero-copy p{font-size:var(--text-base);margin-block:var(--space-5)}
  .hero-copy .actions{display:grid}
  .hero-copy .button{justify-content:space-between}
  .hero-visual{padding-block:var(--space-4) var(--space-5)}
  .hero-controls{padding-block:var(--space-4)}
 }
</style>
