---
import { home } from '../data/home';
import { visibility, integrations } from '../config/visibility';
import { anchor } from '../config/urls';
import Icon from './Icon.astro';
---
<section id="nuvem" class="section parchment"><div class="container"><div class="section-head"><h2>{home.cloudTitle}</h2><div><p>{home.cloudText}</p><p class="instruction">{home.cloudInstruction}</p></div></div><div class="cloud-placeholder" role="region" aria-label="Visualizador da nuvem de pontos"><span>Visualizador da nuvem de pontos</span></div><div class="actions">{visibility.cloud && integrations.cloud && <a class="button outline" target="_blank" rel="noopener" href={integrations.cloud}>Abrir a nuvem<Icon/></a>}<a class="button" href={anchor('contato')}>Quero isso na minha obra<Icon/></a></div></div></section>
<style>.instruction{margin-top:var(--space-5);font-size:var(--text-sm)}.cloud-placeholder{aspect-ratio:21/8;display:grid;place-items:center;border:1px solid var(--color-line);background:var(--color-pearl);color:var(--color-muted);font-size:var(--text-sm);padding:var(--space-6);text-align:center}.actions{margin-top:var(--space-5);justify-content:flex-end}@media(max-width:600px){.cloud-placeholder{aspect-ratio:4/3}.actions{justify-content:flex-start}}</style>
