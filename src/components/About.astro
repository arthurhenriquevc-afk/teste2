---
import { home } from '../data/home';
import Media from './Media.astro';
---
<section id="sobre" class="section"><div class="container about"><div><h2>{home.aboutTitle}</h2><p>{home.aboutText}</p><dl><div><dt>2016</dt><dd>As-built de obra desde</dd></div><div><dt>2019</dt><dd>Laser scanner de ponta desde</dd></div></dl></div><Media path="/src/assets/sobre/operador.webp" alt="Operador da UNION3D com o laser scanner FARO Focus Premium sobre a armação de uma laje, em dia de chuva" ratio="4/5"/></div></section>
<style>.about{display:grid;grid-template-columns:1.1fr 1fr;gap:var(--space-9);align-items:center}.about p{font-size:var(--text-md);margin-top:var(--space-6)}dl{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-6);margin:var(--space-7) 0 0}dl>div{border-top:1px solid var(--color-line);padding-top:var(--space-5)}dt{font-size:var(--text-heading);line-height:1.2;font-variant-numeric:tabular-nums}dd{margin:var(--space-2) 0 0;font-size:var(--text-sm)}@media(max-width:800px){.about{gap:var(--space-7);grid-template-columns:1fr 1fr}.about p{font-size:var(--text-base)}}@media(max-width:600px){.about{grid-template-columns:1fr}.about :global(.media){aspect-ratio:4/3!important}}</style>
