---
import { cases } from '../data/proof';
import Media from './Media.astro';
import { local } from '../config/urls';
---
<section id="cases" class="section"><div class="container"><h2>Cases de escaneamento 3D em Santa Catarina.</h2><div class="case-list">{cases.map(item=><article><div class="compare"><div class="compare-images"><Media path={item.photo} alt={item.alt} ratio="7/5"/><div class="compare-overlay"><Media path={item.cloud} alt={item.alt} ratio="7/5"/></div></div><label>Comparar foto e nuvem de pontos<input type="range" min="0" max="100" value="50" aria-label="Comparar foto e nuvem de pontos"/></label></div><div><p>{item.window}</p><h3>{item.title}</h3><dl>{item.location && <div><dt>Local</dt><dd>{item.location}</dd></div>}{item.company && <div><dt>Construtora</dt><dd>{item.company}</dd></div>}{[['O desafio',item.challenge],['A solução UNION3D',item.solution],['Resultado',item.result]].map(([label,text])=>text && <div><dt>{label}</dt><dd>{text}</dd></div>)}</dl>{item.url && <a class="text-link" href={local(item.url)}>Ver case</a>}</div></article>)}</div></div></section>
<script>
 document.querySelectorAll<HTMLElement>('.compare').forEach(compare=>{const slider=compare.querySelector<HTMLInputElement>('input')!;const images=compare.querySelector<HTMLElement>('.compare-images')!;slider.addEventListener('input',()=>images.style.setProperty('--compare-position',slider.value+'%'));});
</script>
<style>.case-list{margin-top:var(--space-8);display:grid;gap:var(--space-8)}article{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-7);align-items:center}.compare-images{position:relative;--compare-position:50%}.compare-overlay{position:absolute;inset:0;clip-path:inset(0 0 0 var(--compare-position))}.compare-images:after{content:'';position:absolute;top:0;bottom:0;left:var(--compare-position);border-left:2px solid var(--color-primary)}label{display:flex;flex-direction:column;gap:var(--space-3);margin-top:var(--space-4);font-size:var(--text-sm)}input{width:100%;min-height:var(--tap-size);accent-color:var(--color-primary)}h3{margin-block:var(--space-4) var(--space-5)}dl{margin:0}dl>div{margin-top:var(--space-4)}dt{font-weight:var(--weight-semibold)}dd{margin:0}@media(max-width:700px){article{grid-template-columns:1fr}}</style>
