---
const { name = 'arrow' } = Astro.props;
const paths = { arrow:'M4 12h16M14 6l6 6-6 6', left:'M20 12H4m6-6-6 6 6 6', close:'m6 6 12 12M6 18 18 6', menu:'M4 6h16M4 12h16M4 18h16', plus:'M12 5v14M5 12h14', whatsapp:'M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3 21l1.7-5a8.5 8.5 0 1 1 15.8-4.4ZM9 8c-.8 1 .3 3 1.5 4.2s3.2 2.2 4.2 1.5l1-1.1-2-1-1 1c-1.2-.5-2.4-1.7-2.9-2.9l1-1-1-2Z' };
---
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-direction={name==='left'?'left':undefined}><path d={paths[name as keyof typeof paths] || paths.arrow} stroke-linecap="round" stroke-linejoin="round"/></svg>
