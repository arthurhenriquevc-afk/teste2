---
import { home } from '../data/home';
import { windows } from '../data/windows';
import { cities } from '../data/cities';
import { company } from '../data/company';
import Icon from './Icon.astro';
const cityOptions = cities.map(c=>c.split(' (')[0]);
---
<section id="contato" class="section dark"><div class="container contact"><div class="contact-intro"><h2>{home.contactTitle}</h2><p>{home.contactText}</p><a class="text-link" href={`tel:${company.phoneLink}`}>{company.phone}</a></div>
<form id="quote-form" novalidate>
 <div class="form-field full"><label for="stage">Em que etapa a obra está</label><select id="stage" name="stage" required aria-describedby="stage-error"><option value="">Escolha a etapa da obra</option>{windows.map((w,i)=><option>{i===6 ? 'Retrofit ou vendas':w.title}</option>)}</select><span class="field-error" id="stage-error" hidden></span></div>
 <div class="form-field"><label for="name">Nome</label><input id="name" name="name" autocomplete="name" placeholder="Seu nome" required aria-describedby="name-error"/><span class="field-error" id="name-error" hidden></span></div>
 <div class="form-field"><label for="phone">WhatsApp</label><input id="phone" name="phone" autocomplete="tel" inputmode="tel" type="tel" placeholder="(47) 90000-0000" maxlength="15" required aria-describedby="phone-error"/><span class="field-error" id="phone-error" hidden></span></div>
 <div class="form-field"><label for="email">E-mail (opcional)</label><input id="email" name="email" autocomplete="email" type="email" placeholder="voce@construtora.com.br" aria-describedby="email-error"/><span class="field-error" id="email-error" hidden></span></div>
 <div class="form-field"><label for="city">Cidade da obra</label><select id="city" name="city" required aria-describedby="city-error"><option value="">Escolha a cidade</option>{[...cityOptions,'Outra cidade'].map(c=><option>{c}</option>)}</select><span class="field-error" id="city-error" hidden></span></div>
 <div class="form-field full"><label for="message">Conte sobre a obra</label><textarea id="message" name="message" rows="4" placeholder="Unidades ou ambientes, e quando precisa"></textarea></div>
 <div class="form-actions full"><button type="submit" class="button light js-only">Solicitar orçamento da minha obra<Icon/></button><a class="text-link" href={company.whatsapp} target="_blank" rel="noopener">Falar pelo WhatsApp agora<Icon name="whatsapp"/></a><p>Sem compromisso.</p></div>
 <p class="full form-status" role="status" aria-live="polite"></p>
</form></div></section>
<script src="../scripts/contact.ts"></script>
<style>.contact{display:grid;grid-template-columns:1fr 1.2fr;gap:var(--space-9)}.contact-intro p{margin-top:var(--space-6);font-size:var(--text-md)}.contact-intro>a{margin-top:var(--space-5)}form{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-5)}.full{grid-column:1/-1}.form-field{display:flex;flex-direction:column;gap:var(--space-2);min-width:0}label{font-size:var(--text-sm)}input,select,textarea{background:var(--color-canvas);color:var(--color-primary);padding:var(--space-3) var(--space-4);border:1px solid var(--color-muted);border-radius:var(--radius-sm);width:100%;caret-color:var(--color-primary);min-height:50px}input::placeholder,textarea::placeholder{color:var(--color-muted);opacity:1}input:focus-visible,select:focus-visible,textarea:focus-visible{outline-color:var(--color-canvas)}input[aria-invalid=true],select[aria-invalid=true]{outline:2px solid var(--color-canvas);outline-offset:2px}textarea{resize:vertical}.field-error{font-size:var(--text-sm);font-weight:var(--weight-medium)}.form-actions{display:flex;flex-direction:column;align-items:start;gap:var(--space-3)}.form-actions p{font-size:var(--text-xs)}.form-status{font-size:var(--text-sm)}@media(max-width:900px){.contact{gap:var(--space-7);grid-template-columns:1fr}.contact-intro h2{max-width:25ch}}@media(max-width:480px){form{grid-template-columns:1fr}.full{grid-column:1}.form-actions .button{width:100%;justify-content:space-between}}</style>
