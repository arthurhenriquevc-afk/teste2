---
import Logo from './Logo.astro';
import Media from './Media.astro';
import Icon from './Icon.astro';
import { services } from '../data/services';
import { company } from '../data/company';
import { visibility } from '../config/visibility';
import { local, anchor } from '../config/urls';
---
<a class="skip-link button" href="#conteudo">Pular para o conteúdo</a>
<header class="site-header">
 <div class="container header-row">
  <Logo/>
  <button class="mobile-toggle js-only text-link" aria-controls="main-nav" aria-expanded="false"><span>Menu</span><Icon name="menu"/></button>
  <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
   <a href={anchor('janelas')} data-mega="Empresas" aria-controls="mega-menu">Para empresas</a>
   <a href={anchor('janelas')} data-mega="Profissionais" aria-controls="mega-menu">Para profissionais</a>
   <a href={anchor('tecnologia')}>Tecnologia e precisão</a>
   {visibility.cases && <a href={anchor('cases')}>Cases</a>}
   <a href={anchor('sobre')}>Sobre</a><a href={anchor('contato')}>Contato</a>
  </nav>
  <a class="button" href={anchor('contato')}>Solicitar orçamento<Icon/></a>
 </div>
 <div class="mega" id="mega-menu" hidden>
  <div class="container">
   <div class="mega-top">
    <div class="tabs" role="tablist" aria-label="Público dos serviços">
     {['Empresas','Profissionais'].map((audience,i)=><button id={`tab-${audience}`} role="tab" aria-selected={i===0 ? 'true':'false'} tabindex={i===0 ? 0:-1} aria-controls={`panel-${audience}`} data-audience={audience}>Para {audience.toLowerCase()}</button>)}
    </div>
    <button class="icon-button" data-close-mega aria-label="Fechar serviços"><Icon name="close"/></button>
   </div>
   {['Empresas','Profissionais'].map((audience,i)=><div class="service-grid" id={`panel-${audience}`} role="tabpanel" aria-labelledby={`tab-${audience}`} hidden={i!==0}>
    {services.filter(s=>s.audience===audience).map(s=><article class="service-card">
     <Media path={s.image} alt={s.alt}/><span class="number">{s.id}</span><h3 data-service-name>{s.name}</h3>
     <div class="actions"><a class="text-link" href={local(s.url)} aria-label={`Saiba mais: ${s.name}`}>Saiba mais<Icon/></a><a class="text-link" href={company.whatsapp} target="_blank" rel="noopener" aria-label={`Agendar: ${s.name}`}>Agendar</a></div>
    </article>)}
   </div>)}
  </div>
 </div>
</header>
<script src="../scripts/navigation.ts"></script>
