---
import { windows } from '../data/windows';
import { services } from '../data/services';
import { home } from '../data/home';
import { local } from '../config/urls';
import Media from './Media.astro';
import Icon from './Icon.astro';
---
<section id="janelas" class="section parchment"><div class="container">
 <div class="section-head"><h2>{home.windowsTitle}</h2><p>{home.windowsText}</p></div>
 <div class="window-toolbar js-only"><div class="window-filters" role="group" aria-label="Filtrar serviços por público"><button data-window-filter="Todos" aria-pressed="true">Ver todos os serviços</button><button data-window-filter="Empresas" aria-pressed="false">Ver serviços para empresas</button><button data-window-filter="Profissionais" aria-pressed="false">Ver serviços para profissionais</button></div><div class="window-navigation"><button class="text-link" data-window-prev><Icon name="left"/>Voltar</button><span data-window-count aria-live="polite">01 / 07</span><button class="text-link" data-window-next>Avançar<Icon/></button></div></div>
 <div class="window-timeline js-only" role="group" aria-label="Ir para uma etapa da obra">{windows.map((w,i)=><button type="button" data-window-step={i} aria-label={`Ir para a janela ${i+1}: ${w.title}`}><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span>{w.title}</span></button>)}</div>
 <div class="window-track" tabindex="0" role="region" aria-roledescription="carrossel" aria-label="Janelas de escaneamento, arraste ou use as setas">
 {windows.map(w=><article class="window" data-window aria-label={w.aria}>
  <div class="window-main"><span class="window-label">{w.label}</span><h3>{w.title}</h3><div class="window-scan"><h4>O que escaneamos</h4><p>{w.scan}</p></div><Media path={w.image} alt={w.alt}/></div>
  <div class="window-services">{services.filter(s=>w.serviceIds.includes(s.id)).map(s=><a href={local(s.url)} data-window-service={s.audience}><span class="service-id">{s.id}</span><div><h4 data-service-name>{s.name}</h4><p>{s.description}</p></div><Icon/></a>)}</div>
 </article>)}
 </div>
</div></section>
<script src="../scripts/windows.ts"></script>
<style>
 .window-toolbar{display:flex;align-items:center;justify-content:space-between;gap:var(--space-5);width:100%;margin-bottom:var(--space-6);flex-wrap:wrap}.window-filters{display:flex;gap:var(--space-2);flex-wrap:wrap}.window-filters button{padding:var(--space-3) var(--space-4);border:1px solid var(--color-line);border-radius:var(--radius-sm);font-size:var(--text-sm)}.window-filters button[aria-pressed=true]{text-decoration:underline;text-underline-offset:var(--underline-active);font-weight:var(--weight-semibold);background:var(--color-primary);color:var(--color-canvas);border-color:var(--color-primary)}.window-filters button:hover{border-color:var(--color-primary)}.window-navigation{display:flex;align-items:center;gap:var(--space-5)}.window-navigation span{font-variant-numeric:tabular-nums;font-size:var(--text-sm);min-width:4rem;text-align:center}.window-track{display:grid;gap:var(--space-6)}html[data-enhanced] .window-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-inline:contain;cursor:grab;scroll-behavior:smooth}html[data-enhanced] .window-track::-webkit-scrollbar{display:none}html[data-enhanced] .window-track[data-dragging]{cursor:grabbing;scroll-snap-type:none;scroll-behavior:auto;user-select:none}.window{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8);background:var(--color-canvas);padding:var(--space-7);border-radius:var(--radius-card);flex:0 0 100%;scroll-snap-align:start;min-width:0}.window-main{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4)}.window-label{font-size:var(--text-sm);grid-column:1/-1}.window h3{font-size:var(--text-heading);grid-column:1/-1;max-width:18ch}.window-scan{align-self:start}.window-scan h4{font-size:var(--text-sm);font-weight:var(--weight-semibold);letter-spacing:var(--tracking-normal);margin:var(--space-4) 0 var(--space-3)}.window-scan p{font-size:var(--text-sm)}.window-main :global(.media){align-self:end;aspect-ratio:4/5}.window-services{display:flex;flex-direction:column;justify-content:center}.window-services>a{display:grid;grid-template-columns:auto 1fr auto;gap:var(--space-4);padding-block:var(--space-6);border-top:1px solid var(--color-line);text-decoration:none}.window-services>a:hover h4{text-decoration:underline;text-underline-offset:var(--underline-compact)}.window-services h4{font-size:var(--text-lg);margin-bottom:var(--space-3);line-height:var(--leading-dense);letter-spacing:var(--tracking-subheading)}.window-services p{font-size:var(--text-sm)}.service-id{font-variant-numeric:tabular-nums;font-size:var(--text-sm);padding-top:var(--space-1);color:var(--color-muted)}.window-services>a>svg{margin-top:var(--space-1)}
 @media(max-width:960px){.window{grid-template-columns:1fr;gap:var(--space-6);padding:var(--space-6)}.window-main{grid-template-columns:1.5fr 1fr}.window-main :global(.media){grid-column:2;grid-row:1/4;aspect-ratio:4/5}.window-label,.window h3{grid-column:1}.window-scan h4{margin-top:0}.window h3{font-size:var(--text-xl)}.window-toolbar{gap:var(--space-4)}.window-navigation{width:100%;justify-content:space-between}.window-services{justify-content:start}}
 @media(max-width:480px){.window-navigation{gap:var(--space-2)}.window-navigation .text-link{gap:var(--space-2);font-size:var(--text-sm)}.window{padding:var(--space-5)}.window-main{grid-template-columns:1fr}.window-main :global(.media){grid-row:auto;grid-column:1;aspect-ratio:16/7}.window-services>a{gap:var(--space-3)}.window-services>a>svg{display:none}.window-services>a{grid-template-columns:auto 1fr}.window-filters{display:grid;width:100%}.window-filters button{text-align:left}.window-services h4{font-size:var(--text-lg)}}
</style>
<style>
 html[data-enhanced] .window-timeline{display:flex;gap:var(--space-3);margin-bottom:var(--space-6)}
 .window-timeline button{flex:1;min-width:0;text-align:left;padding:var(--space-3) 0 var(--space-4);position:relative;display:flex;flex-direction:column;gap:var(--space-2);border-bottom:1px solid var(--color-line);font-size:var(--text-xs);line-height:var(--leading-control)}
 .window-timeline button>span:first-child{font-variant-numeric:tabular-nums;font-size:var(--text-lg)}
 .window-timeline button:after{content:'';position:absolute;inset:auto 0 -1px;height:2px;background:var(--color-primary);transform:scaleX(0);transform-origin:left;transition:transform var(--duration-normal) var(--ease-out)}
 .window-timeline button[aria-current]:after{transform:scaleX(1)}.window-timeline button[aria-current]{font-weight:var(--weight-semibold)}
 @media(max-width:600px){.window-timeline{flex-wrap:wrap}.window-timeline button{flex:1 0 calc(25% - var(--space-3));min-width:var(--tap-size);align-items:center;min-height:var(--tap-size);justify-content:center}.window-timeline button>span:last-child{display:none}.window-timeline button>span:first-child{font-size:var(--text-sm)}}
</style>
