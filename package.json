{
  "name": "union3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-html.mjs && node scripts/check-copy.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "check:html": "node scripts/check-html.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "astro": "7.4.5",
    "geist": "1.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "lighthouse": "^13.6.0",
    "parse5": "^8.1.0"
  }
}
